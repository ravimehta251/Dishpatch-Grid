DB_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
MONITORING_TOKEN=
GRAFANA_ADMIN_PASSWORD=
RECEIVER_CONTROL_TOKEN=
API_PORT=8080
DASHBOARD_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
RECEIVER_PORT=8090
WORKER_CONCURRENCY=8
OUTBOX_POLL_MS=20
